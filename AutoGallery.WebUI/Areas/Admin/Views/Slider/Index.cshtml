@model List<Slider>
@{
    ViewData["Title"] = "Slider Yönetimi";
}

<div class="card shadow-sm border-0 rounded-3 mt-3">
    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center pt-4 pb-3 px-4">
        <h5 class="mb-0 fw-bold">Ana Sayfa Slider Listesi</h5>
        <a asp-action="Create" class="btn rounded-pill px-4 text-white d-flex align-items-center" style="background-color: #b6905b; border: none; font-weight: 500;">
            <i class="bi bi-plus-lg me-2"></i> Yeni Slider Ekle
        </a>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-dark">
                    <tr>
                        <th class="ps-4 py-3 fw-semibold border-bottom-0" style="width: 120px;">Görsel</th>
                        <th class="py-3 fw-semibold border-bottom-0">Başlık & Detay</th>
                        <th class="py-3 fw-semibold border-bottom-0">Buton & Link</th>
                        <th class="py-3 fw-semibold border-bottom-0">Sıra</th>
                        <th class="py-3 fw-semibold border-bottom-0">Durum</th>
                        <th class="text-end pe-4 py-3 fw-semibold border-bottom-0">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="bg-light rounded-2 d-flex align-items-center justify-content-center overflow-hidden" style="width: 100px; height: 56px;">
                                    <img src="@item.ImageUrl" alt="@item.Title" class="w-100 h-100" style="object-fit: cover;" onerror="this.onerror=null;this.src='/images/placeholder.jpg';this.style.display='none';this.parentElement.innerHTML='<i class=\'bi bi-image text-muted fs-4\'></i>';" />
                                </div>
                            </td>
                            <td class="py-3">
                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@item.Title</div>
                                @if (!string.IsNullOrEmpty(item.SubTitle))
                                {
                                    <div class="text-secondary text-truncate" style="font-size: 0.85rem; max-width: 250px;">@item.SubTitle</div>
                                }
                            </td>
                            <td class="py-3">
                                @if (!string.IsNullOrEmpty(item.ButtonText))
                                {
                                    <div class="text-dark fw-medium" style="font-size: 0.90rem;">@item.ButtonText</div>
                                    <div class="text-secondary text-truncate" style="font-size: 0.80rem; max-width: 150px;">@item.ButtonUrl</div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="fw-bold text-dark py-3">@item.Order</td>
                            <td class="py-3">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-medium">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 fw-medium">Pasif</span>
                                }
                            </td>
                            <td class="text-end pe-4 py-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-4 fw-medium">
                                    <i class="bi bi-pencil me-1"></i> Düzenle
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-circle ms-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" onclick="return confirm('Bu slider\'ı silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted border-top">
                    <i class="bi bi-images fs-1 d-block mb-3 text-secondary"></i>
                    <h5>Gösterilecek hiç slider bulunmuyor.</h5>
                    <p class="mb-0">Sağ üstteki "Yeni Slider Ekle" butonunu kullanarak ana sayfa vitrininizi oluşturmaya başlayabilirsiniz.</p>
                </div>
            }
        </div>
    </div>
</div>