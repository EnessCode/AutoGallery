@model CreateCarViewModel
<div class="tab-pane fade" id="pane-images" role="tabpanel">
    <div class="mb-4 pb-3 border-bottom">
        <h5 class="fw-bold mb-1">Fotoðraflar</h5>
        <div class="text-muted small">Birden fazla fotoðraf yükleyebilirsiniz. Yýldýz ikonuyla vitrin (ana) fotoðrafýný seçin.</div>
    </div>

    <label class="dropzone d-block text-center p-5 border border-2 border-dashed rounded-3 bg-light mb-4" id="dropzone" for="UploadedImages" style="cursor: pointer;">
        <i class="bi bi-cloud-arrow-up fs-1 text-secondary"></i>
        <b class="d-block mt-2">Fotoðraflarý sürükleyip býrakýn veya seçmek için týklayýn</b>
        <small class="text-muted">JPG, PNG, WEBP (En fazla 20 adet, max 8 MB)</small>
    </label>
    <input type="file" id="UploadedImages" name="UploadedImages" accept="image/jpeg,image/png,image/webp" multiple hidden />
    <input type="hidden" asp-for="MainImageIndex" />

    <div class="thumb-grid d-flex flex-wrap gap-3" id="thumbGrid"></div>
</div>