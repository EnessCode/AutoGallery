@model EditCarViewModel
@{
    string NumVal(string key, decimal value)
    {
        if (ViewData.ModelState.TryGetValue(key, out var entry) && entry.AttemptedValue != null)
            return entry.AttemptedValue;
        return value == 0 ? "" : value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }
}

<div class="tab-pane fade show active" id="pane-basic" role="tabpanel">
    <div class="mb-4 pb-3 border-bottom">
        <h5 class="fw-bold mb-1">Temel Bilgiler</h5>
        <div class="text-muted small">İlanın başlığı, marka/model ve fiyat bilgileri.</div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <label asp-for="Title" class="form-label fw-semibold">İlan Başlığı</label>
            <input asp-for="Title" class="form-control" placeholder="Örn. BMW 3.20i Luxury Line" required />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Brand" class="form-label fw-semibold">Marka</label>
            <input asp-for="Brand" class="form-control" placeholder="Örn. BMW" required />
            <span asp-validation-for="Brand" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Model" class="form-label fw-semibold">Model</label>
            <input asp-for="Model" class="form-control" placeholder="Örn. 3 Serisi" required />
            <span asp-validation-for="Model" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Year" class="form-label fw-semibold">Model Yılı</label>
            <input asp-for="Year" type="number" min="1950" max="2100" value="@NumVal("Year", Model.Year)" class="form-control" placeholder="2022" required />
            <span asp-validation-for="Year" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Price" class="form-label fw-semibold">Fiyat</label>
            <div class="input-group">
                <input asp-for="Price" type="number" min="1" step="0.01" value="@NumVal("Price", Model.Price)" class="form-control" placeholder="2180000" required />
                <span class="input-group-text">₺</span>
            </div>
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Kilometer" class="form-label fw-semibold">Kilometre</label>
            <div class="input-group">
                <input asp-for="Kilometer" type="number" min="0" step="1" value="@NumVal("Kilometer", Model.Kilometer)" class="form-control" placeholder="18400" required />
                <span class="input-group-text">km</span>
            </div>
            <span asp-validation-for="Kilometer" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
            <textarea asp-for="Description" rows="5" class="form-control" placeholder="Aracın öne çıkan özellikleri, bakım geçmişi, satış notları..."></textarea>
        </div>
        <div class="col-md-6">
            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 border h-100">
                <div>
                    <b class="d-block mb-1">Vitrinde öne çıkar</b>
                    <small class="text-muted">Ana sayfadaki öne çıkanlarda gösterilir.</small>
                </div>
                <div class="form-check form-switch m-0">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" style="width:2.6em;height:1.4em;" />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex align-items-center justify-content-between p-3 bg-danger-subtle rounded-3 border border-danger-subtle h-100">
                <div>
                    <b class="d-block mb-1 text-danger-emphasis">Satıldı olarak işaretle</b>
                    <small class="text-danger">Araç satıldıysa listelemede satıldı etiketi alır.</small>
                </div>
                <div class="form-check form-switch m-0">
                    <input asp-for="IsSold" class="form-check-input bg-danger border-danger" type="checkbox" role="switch" style="width:2.6em;height:1.4em;" />
                </div>
            </div>
        </div>
    </div>
</div>