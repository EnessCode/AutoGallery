@model List<ContactMessage>
@{
    ViewData["Title"] = "Gelen Mesajlar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Durum</th>
                        <th>Gönderen</th>
                        <th>E-Posta</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsRead ? "" : "bg-light fw-semibold")">
                            <td class="ps-4">
                                @if (item.IsRead)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill"><i class="bi bi-check2-all"></i> Okundu</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill"><i class="bi bi-envelope"></i> Yeni</span>
                                }
                            </td>
                            <td>@item.Name</td>
                            <td><a href="mailto:@item.Email" class="text-decoration-none text-body">@item.Email</a></td>
                            <td>@item.Subject</td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-eye"></i> İncele
                                </a>
                                @if (!item.IsRead)
                                {
                                    <a asp-action="MarkAsRead" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success rounded-pill px-3 ms-1">
                                        <i class="bi bi-check2"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                    <h5>Henüz hiç mesaj bulunmuyor.</h5>
                    <p>Yeni bir iletişim formu doldurulduğunda burada listelenecektir.</p>
                </div>
            }
        </div>
    </div>
</div>