@model GalleryInfo

@{
    ViewData["Title"] = "Galeri Bilgilerini Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-store text-primary me-2"></i> Galeri & İletişim Bilgileri</h5>
                        <small class="text-muted">Web sitenizin iletişim sayfasında görünen bilgileri buradan güncelleyebilirsiniz.</small>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left"></i> Mesajlara Dön
                    </a>
                </div>
            </div>

            <div class="card-body p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-action="Index" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Title" class="form-label fw-semibold">Galeri / Şube Adı</label>
                            <input asp-for="Title" class="form-control" placeholder="Örn: Merkez Showroom" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">E-Posta Adresi</label>
                            <input asp-for="Email" class="form-control" placeholder="info@autogallery.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone1" class="form-label fw-semibold">Birincil Telefon</label>
                            <input asp-for="Phone1" class="form-control" placeholder="0212 555 40 40" />
                            <span asp-validation-for="Phone1" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone2" class="form-label fw-semibold">İkincil Telefon <span class="text-muted fw-normal">(Opsiyonel)</span></label>
                            <input asp-for="Phone2" class="form-control" placeholder="0850 333 20 20" />
                            <span asp-validation-for="Phone2" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">Açık Adres</label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Mahalle, Cadde, No, İlçe / İl"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="GoogleMapUrl" class="form-label fw-semibold">Google Harita / Yol Tarifi Linki <span class="text-muted fw-normal">(Opsiyonel)</span></label>
                            <input asp-for="GoogleMapUrl" class="form-control" placeholder="https://goo.gl/maps/..." />
                            <span asp-validation-for="GoogleMapUrl" class="text-danger small"></span>
                            <div class="form-text">Bu alan doldurulduğunda ön yüzde adrese tıklandığında doğrudan harita açılır.</div>
                        </div>

                        <hr class="my-4 text-muted">

                        <div class="col-md-6">
                            <label asp-for="WorkingHoursWeekdays" class="form-label fw-semibold">Hafta İçi Çalışma Saatleri</label>
                            <input asp-for="WorkingHoursWeekdays" class="form-control" placeholder="Hafta İçi / Cumartesi: 09:00 - 19:00" />
                            <span asp-validation-for="WorkingHoursWeekdays" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="WorkingHoursWeekend" class="form-label fw-semibold">Hafta Sonu Çalışma Saatleri</label>
                            <input asp-for="WorkingHoursWeekend" class="form-control" placeholder="Pazar: Randevulu Hizmet" />
                            <span asp-validation-for="WorkingHoursWeekend" class="text-danger small"></span>
                        </div>

                        <hr class="my-4 text-muted">

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-share me-1"></i> Sosyal Medya Hesapları <span class="text-muted fw-normal small">(Boş bırakılanlar gösterilmez)</span></h6>

                        <div class="col-md-4">
                            <label asp-for="InstagramUrl" class="form-label fw-semibold">Instagram URL</label>
                            <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/..." />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LinkedinUrl" class="form-label fw-semibold">LinkedIn URL</label>
                            <input asp-for="LinkedinUrl" class="form-control" placeholder="https://linkedin.com/..." />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="YoutubeUrl" class="form-label fw-semibold">YouTube URL</label>
                            <input asp-for="YoutubeUrl" class="form-control" placeholder="https://youtube.com/..." />
                        </div>

                        <div class="col-12 pt-3 text-end">
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                                <i class="bi bi-save me-2"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>