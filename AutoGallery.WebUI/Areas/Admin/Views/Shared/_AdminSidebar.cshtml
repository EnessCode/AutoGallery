@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    Func<string, string> active = ctrl => current == ctrl ? "active" : "";
}
<aside class="adm-sidebar" id="admSidebar">
    <a href="/Admin" class="adm-brand">AUTO<span>GALLERY</span></a>

    <div class="adm-nav-label">Genel</div>
    <ul class="adm-nav">
        <li><a href="/Admin/Dashboard" class="@active("Dashboard")"><i class="bi bi-grid-1x2"></i> Panel</a></li>
        <li><a href="/Admin/Slider" class="@active("Slider")"><i class="bi bi-images"></i> Slider Yönetimi</a></li>
    </ul>

    <div class="adm-nav-label">Portföy</div>
    <ul class="adm-nav">
        <li><a href="/Admin/Cars" class="@active("Cars")"><i class="bi bi-car-front"></i> Araçlar</a></li>
        <li><a href="/Admin/ExpertiseInfo" class="@active("ExpertiseInfo")"><i class="bi bi-clipboard2-check"></i> Ekspertiz Bilgileri</a></li>
        <li><a href="/Admin/Features" class="@active("Features")"><i class="bi bi-stars"></i> Donanım Kategorileri</a></li>
        <li><a href="/Admin/About" class="@active("About")"><i class="bi bi-info-circle"></i> Hakkımızda</a></li>
    </ul>

    <div class="adm-nav-label">Talepler</div>
    <ul class="adm-nav">
        <li>
            <a href="/Admin/Consignment" class="@active("Consignment")">
                <i class="bi bi-inbox"></i> Konsinye Talepleri
            </a>
        </li>
        <li>
            <a href="/Admin/Contact" class="@active("Contact")">
                <i class="bi bi-chat-left-text"></i> Gelen Mesajlar
            </a>
        </li>
        <li>
            <a href="/Admin/GalleryInfo" class="@active("GalleryInfo")">
                <i class="bi bi-geo-alt"></i> Galeri Bilgileri
            </a>
        </li>
    </ul>

    <div class="adm-sidebar-foot">
        <a href="/" target="_blank" class="mb-2" style="display: flex; align-items: center; gap: 10px; color: var(--tx-lm); text-decoration: none;">
            <i class="bi bi-globe"></i> Siteye Git
        </a>
        <a href="/Account/Logout" style="display: flex; align-items: center; gap: 10px; color: #dc3545; text-decoration: none; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <i class="bi bi-box-arrow-left"></i> Çıkış Yap
        </a>
    </div>
</aside>
<div class="adm-overlay" id="admOverlay"></div>
