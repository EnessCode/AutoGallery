@{
    var fullName = User.Identity.Name;
    var initials = "AA";
    if (!string.IsNullOrEmpty(fullName))
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            initials = $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        else if (parts.Length == 1)
        {
            initials = $"{char.ToUpper(parts[0][0])}";
        }
    }
}

<header class="adm-topbar">
    <div class="adm-topbar-left">
        <button class="adm-burger" id="admBurger" type="button" aria-label="Menüyü aç">
            <i class="bi bi-list"></i>
        </button>
        <span class="adm-page-title">@ViewData["Title"]</span>
    </div>

    <div class="adm-topbar-right">
        <div class="adm-user">
            <div class="adm-avatar">@initials</div>
            <div>
                <div class="adm-user-name">@fullName</div>
                <div class="adm-user-role">Galeri Yöneticisi</div>
            </div>
        </div>
    </div>
</header>
