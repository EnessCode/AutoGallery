@model ExpertiseInfo
@{
    ViewData["Title"] = "Ekspertiz Alanı Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="h4 mb-0 fw-bold">Ekspertiz Alanı Yönetimi</h2>
        <div class="text-muted small mt-1">Ana sayfadaki "%100 Şeffaflık Garantisi" bölümünü buradan yönetebilirsiniz.</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-area="Admin" asp-controller="ExpertiseInfo" asp-action="Index" method="post" class="adm-form" novalidate>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAt" />

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
            <h5 class="mb-0 fw-semibold text-dark"><i class="bi bi-shield-check me-2"></i>Ekspertiz Bölümü İçerikleri</h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-12">
                    <label class="form-label fw-medium">Üst Başlık (Eyebrow)</label>
                    <input type="text" asp-for="SubTitle" class="form-control rounded-3" placeholder="Örn: %100 Şeffaflık Garantisi" required />
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-medium">Ana Başlık (HTML &lt;br&gt; etiketi kullanabilirsiniz)</label>
                    <textarea asp-for="Title" class="form-control rounded-3" rows="2" placeholder="Örn: Her aracın hikayesi,<br>satın almadan önce elinizde." required></textarea>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-medium">Açıklama Metni</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Kurumsal şeffaflık açıklaması..." required></textarea>
                </div>

                <!-- 1. İSTATİSTİK -->
                <div class="col-md-6">
                    <label class="form-label fw-medium">1. İstatistik Değer (Örn: 18 Yıl)</label>
                    <input type="text" asp-for="Stat1Value" class="form-control rounded-3" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium">1. İstatistik Etiket (Örn: Sektör Tecrübesi)</label>
                    <input type="text" asp-for="Stat1Label" class="form-control rounded-3" required />
                </div>

                <!-- 2. İSTATİSTİK -->
                <div class="col-md-6">
                    <label class="form-label fw-medium">2. İstatistik Değer (Örn: 13)</label>
                    <input type="text" asp-for="Stat2Value" class="form-control rounded-3" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium">2. İstatistik Etiket (Örn: Kontrol Noktası)</label>
                    <input type="text" asp-for="Stat2Label" class="form-control rounded-3" required />
                </div>

                <!-- 3. İSTATİSTİK -->
                <div class="col-md-6">
                    <label class="form-label fw-medium">3. İstatistik Değer (Örn: %0)</label>
                    <input type="text" asp-for="Stat3Value" class="form-control rounded-3" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-medium">3. İstatistik Etiket (Örn: Gizli Hasar Politikası)</label>
                    <input type="text" asp-for="Stat3Label" class="form-control rounded-3" required />
                </div>

            </div>
        </div>

        <div class="card-footer bg-light border-top p-4 d-flex justify-content-end rounded-bottom-3 gap-2">
            <button type="submit" class="btn text-white px-5 rounded-pill fw-bold" style="background-color: #b6905b;"><i class="bi bi-check2-circle me-1"></i> Değişiklikleri Kaydet</button>
        </div>
    </div>
</form>