@model List<ConsignmentRequest>
@{
    ViewData["Title"] = "Konsinye / Araç Alım Talepleri";
}

<div class="card shadow-sm border-0 rounded-3 mt-3">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
        <h5 class="mb-0 fw-bold">Gelen Araç Teklif / Konsinye Talepleri</h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-dark">
                    <tr>
                        <th class="ps-4 py-3">Müşteri</th>
                        <th class="py-3">Telefon</th>
                        <th class="py-3">Araç Bilgisi</th>
                        <th class="py-3">Yıl / KM</th>
                        <th class="py-3">Not</th>
                        <th class="py-3">Durum</th>
                        <th class="text-end pe-4 py-3">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 fw-bold text-dark">@item.FullName</td>
                            <td class="py-3"><a href="tel:@item.Phone" class="text-decoration-none">@item.Phone</a></td>
                            <td class="py-3 fw-medium">@item.BrandAndModel</td>
                            <td class="py-3">@item.Year · @item.Kilometer.ToString("N0") km</td>
                            <td class="py-3 text-muted small" style="max-width: 200px;">@(item.Note ?? "-")</td>
                            <td class="py-3">
                                @if (item.IsProcessed)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">İncelendi</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2">Yeni Talep</span>
                                }
                            </td>
                            <td class="text-end pe-4 py-3">
                                <a asp-action="ToggleStatus" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                    @(item.IsProcessed ? "Yeni Yap" : "İncelendi İşaretle")
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-circle ms-1" style="width: 32px; height: 32px;" onclick="return confirm('Bu talebi silmek istediğinize emin misiniz?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted border-top">
                    <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                    <h5>Henüz gelen bir konsinye talebi bulunmuyor.</h5>
                </div>
            }
        </div>
    </div>
</div>