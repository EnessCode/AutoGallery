@model List<Car>

@{
    ViewData["Title"] = "Araçlarımız — Stok Portföyü";
}

<!-- ÜST BAŞLIK -->
<div style="background-color: var(--ink2); border-bottom: 1px solid rgba(255,255,255,0.05); padding: 40px 0; margin-bottom: 30px;">
    <div class="container-x">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 0.9rem;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color: var(--brass-lt); text-decoration: none;">Anasayfa</a></li>
                <li class="breadcrumb-item active" aria-current="page" style="color: var(--tx-lm);">Araçlarımız</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="color: var(--tx-l); font-size: 2.2rem;">Güncel Araç Portföyü</h1>
        <p class="mb-0" style="color: var(--tx-lm);">Galerimizde bulunan tüm araçlar 13 nokta ekspertiz garantisiyle satışa sunulmaktadır.</p>
    </div>
</div>

<!-- FİLTRELEME ALANI -->
@await Component.InvokeAsync("CarFilter")

<!-- ARAÇ LİSTESİ -->
@await Component.InvokeAsync("CarList", new { cars = Model })

@if (ViewBag.TotalPages > 1)
{
    <div class="container-x pb-5">
        <nav aria-label="Araç Sayfalama">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       style="color: var(--tx-l); background-color: var(--ink2); border-color: rgba(255,255,255,0.1);"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-search="@ViewBag.SearchTerm"
                       asp-route-gear="@ViewBag.Gear"
                       asp-route-fuel="@ViewBag.Fuel"
                       asp-route-body="@ViewBag.Body"
                       asp-route-sort="@ViewBag.Sort">
                        &laquo; Önceki
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link"
                           style="@(ViewBag.CurrentPage == i ? "background-color: var(--brass); border-color: var(--brass); color: #171410 !important; font-weight: bold;" : "color: var(--tx-lm); background-color: var(--ink2); border-color: rgba(255,255,255,0.1);")"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@ViewBag.SearchTerm"
                           asp-route-gear="@ViewBag.Gear"
                           asp-route-fuel="@ViewBag.Fuel"
                           asp-route-body="@ViewBag.Body"
                           asp-route-sort="@ViewBag.Sort">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       style="color: var(--tx-l); background-color: var(--ink2); border-color: rgba(255,255,255,0.1);"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-search="@ViewBag.SearchTerm"
                       asp-route-gear="@ViewBag.Gear"
                       asp-route-fuel="@ViewBag.Fuel"
                       asp-route-body="@ViewBag.Body"
                       asp-route-sort="@ViewBag.Sort">
                        Sonraki &raquo;
                    </a>
                </li>

            </ul>
        </nav>
    </div>
}
