@model List<Car>

@{
    ViewData["Title"] = "Araçlarımız — Stok Portföyü";
}

<!-- ÜST BAŞLIK -->
<div style="background-color: var(--ink2); border-bottom: 1px solid rgba(255,255,255,0.05); padding: 40px 0; margin-bottom: 30px;">
    <div class="container-x">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 0.9rem;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color: var(--brass-lt); text-decoration: none;">Anasayfa</a></li>
                <li class="breadcrumb-item active" aria-current="page" style="color: var(--tx-lm);">Araçlarımız</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="color: var(--tx-l); font-size: 2.2rem;">Güncel Araç Portföyü</h1>
        <p class="mb-0" style="color: var(--tx-lm);">Galerimizde bulunan tüm araçlar 13 nokta ekspertiz garantisiyle satışa sunulmaktadır.</p>
    </div>
</div>

<!-- FİLTRELEME ALANI -->
@await Component.InvokeAsync("CarFilter")

<!-- ARAÇ LİSTESİ -->
@await Component.InvokeAsync("CarList", new { cars = Model })
