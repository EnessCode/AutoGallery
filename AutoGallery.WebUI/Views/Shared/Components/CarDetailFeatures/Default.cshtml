@model Dictionary<string, List<AutoGallery.Domain.Entities.CarFeature>>

<section class="sec pb-5">
    <div class="container-x">

        <div class="d-flex justify-content-between align-items-end mb-4 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
            <div>
                <h2 class="fw-bold mb-1" style="color: var(--tx-l); font-size: 1.8rem;">Donanım Listesi</h2>
                <p style="color: var(--tx-lm); margin-bottom: 0;">Araca ait iç, dış ve güvenlik donanımlarının detaylı listesi.</p>
            </div>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="row g-4">
                @foreach (var group in Model)
                {
                    <div class="col-12">
                        <div class="p-4" style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">

                            <h4 class="mb-4 fw-bold" style="color: var(--brass-lt); font-size: 1.2rem;">
                                <i class="fa-solid fa-layer-group me-2" style="font-size: 1rem; color: var(--brass);"></i> @group.Key
                            </h4>

                            <div class="row g-3">
                                @foreach (var cf in group.Value)
                                {
                                    <div class="col-12 col-md-6 col-lg-4">
                                        <div class="d-flex align-items-center p-3 h-100" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255,255,255,0.04); border-radius: 8px; transition: all 0.2s ease;">

                                            <div class="flex-shrink-0" style="width: 36px; height: 36px; border-radius: 8px; background: linear-gradient(135deg, rgba(182, 144, 91, 0.2), rgba(182, 144, 91, 0.05)); display: flex; align-items: center; justify-content: center; margin-right: 15px; border: 1px solid rgba(182, 144, 91, 0.2);">
                                                <i class="@cf.Feature.Icon" style="color: var(--brass); font-size: 1rem;"></i>
                                            </div>

                                            <span style="color: #e2e8f0; font-size: 0.95rem; font-weight: 500; line-height: 1.4;">
                                                @cf.Feature.Name
                                            </span>

                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5" style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;">
                <i class="fa-solid fa-car-side fa-3x mb-3" style="color: var(--brass-lt); opacity: 0.5;"></i>
                <h5 style="color: var(--tx-l);">Donanım Bilgisi Yok</h5>
                <p style="color: var(--tx-lm); margin-bottom: 0;">Bu araca ait donanım bilgisi henüz sisteme girilmemiştir.</p>
            </div>
        }
    </div>
</section>