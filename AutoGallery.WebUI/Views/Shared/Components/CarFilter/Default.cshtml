@{
    var fuelTypes = new[] { "Benzin", "Dizel", "LPG", "Hibrit", "Elektrik" };
    var gearTypes = new[] { "Manuel", "Otomatik", "Yarı Otomatik" };
    var bodyTypes = new[] { "Sedan", "Hatchback", "SUV", "Station Wagon", "Coupe", "Cabrio", "Pick-up", "Minivan" };

    var currentSearch = Context.Request.Query["search"].ToString();
    var currentGear = Context.Request.Query["gear"].ToString();
    var currentFuel = Context.Request.Query["fuel"].ToString();
    var currentBody = Context.Request.Query["body"].ToString();
    var currentSort = Context.Request.Query["sort"].ToString();
}

<section class="container-x pb-4">
    <div style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 20px;">
        <form method="get" class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label text-white-50">Marka Ara</label>
                <input type="text" name="search" class="form-control" placeholder="Örn. Mercedes..." value="@currentSearch">
            </div>

            <div class="col-md-3">
                <label class="form-label text-white-50">Vites Tipi</label>
                <select name="gear" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var item in gearTypes)
                    {
                        <option value="@item" selected="@(item == currentGear)">@item</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label text-white-50">Yakıt Tipi</label>
                <select name="fuel" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var item in fuelTypes)
                    {
                        <option value="@item" selected="@(item == currentFuel)">@item</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label text-white-50">Kasa Tipi</label>
                <select name="body" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var item in bodyTypes)
                    {
                        <option value="@item" selected="@(item == currentBody)">@item</option>
                    }
                </select>
            </div>

            <div class="col-md-9 mt-3">
                <label class="form-label text-white-50">Sıralama Ölçütü</label>
                <select name="sort" class="form-select">
                    <option value="newest" selected="@(currentSort == "newest" || string.IsNullOrEmpty(currentSort))">En Yeni Eklenenler (Varsayılan)</option>
                    <option value="price_asc" selected="@(currentSort == "price_asc")">Fiyat (Önce En Düşük)</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc")">Fiyat (Önce En Yüksek)</option>
                    <option value="year_desc" selected="@(currentSort == "year_desc")">Yıl (Önce En Yeni Modeller)</option>
                    <option value="year_asc" selected="@(currentSort == "year_asc")">Yıl (Önce En Eski Modeller)</option>
                    <option value="km_asc" selected="@(currentSort == "km_asc")">Kilometre (Önce En Düşük)</option>
                </select>
            </div>

            <div class="col-md-3 mt-3">
                <button type="submit" class="btn-brass w-100" style="border: none; font-weight: 600; padding: 0.6rem 1rem;">
                    <i class="fa-solid fa-filter me-2"></i>Filtrele ve Sırala
                </button>
            </div>

        </form>
    </div>
</section>