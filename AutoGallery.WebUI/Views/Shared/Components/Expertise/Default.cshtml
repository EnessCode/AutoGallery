@model ExpertiseInfo
@if (Model != null)
{
    <section class="sec sec-alt" id="ekspertiz">
        <div class="container-x">
            <div class="exp-wrap">
                <div>
                    <div class="eyebrow" style="color: var(--brass-lt); margin-bottom:10px;">@Model.SubTitle</div>
                    <div class="sec-head" style="margin-bottom:20px;">
                        <h2 style="color: var(--tx-l); font-size: 2.2rem;">@Html.Raw(Model.Title)</h2>
                    </div>
                    <p style="color:var(--tx-lm);line-height:1.65;margin-bottom:30px; font-size: 1.05rem;">
                        @Model.Description
                    </p>
                    <div class="hero-stats border-0 pt-0">
                        <div class="hstat"><b>@Model.Stat1Value</b><span>@Model.Stat1Label</span></div>
                        <div class="hstat"><b>@Model.Stat2Value</b><span>@Model.Stat2Label</span></div>
                        <div class="hstat"><b>@Model.Stat3Value</b><span>@Model.Stat3Label</span></div>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="svg-card" style="background: var(--ink);">
                        <svg class="svg-car" viewBox="0 0 400 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M30 130 L45 95 Q60 75 95 72 L150 70 L175 50 Q195 40 235 40 L275 45 Q300 55 320 75 L365 80 Q378 84 378 100 L378 128 L30 128 Z" stroke="#b6905b" stroke-width="1.6" />
                            <circle cx="95" cy="130" r="16" stroke="#f4f2ec" stroke-width="1.6" />
                            <circle cx="300" cy="130" r="16" stroke="#f4f2ec" stroke-width="1.6" />
                            <line x1="175" y1="50" x2="175" y2="72" stroke="#f4f2ec" stroke-width="1" opacity=".4" />
                            <line x1="235" y1="40" x2="235" y2="72" stroke="#f4f2ec" stroke-width="1" opacity=".4" />
                        </svg>
                        <span class="tag t1"><span class="dot ok"></span>Kaput — Orijinal</span>
                        <span class="tag t2"><span class="dot paint"></span>Ön tampon — Boyalı</span>
                        <span class="tag t3"><span class="dot ok"></span>Şasi — Sorunsuz</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
