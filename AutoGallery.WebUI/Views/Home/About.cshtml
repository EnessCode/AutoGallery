@{
    ViewData["Title"] = "Hakkımızda — Kurumsal Galeri";
}

<!-- ÜST BAŞLIK -->
<div style="background-color: var(--ink2); border-bottom: 1px solid rgba(255,255,255,0.05); padding: 40px 0; margin-bottom: 30px;">
    <div class="container-x">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 0.9rem;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color: var(--brass-lt); text-decoration: none;">Anasayfa</a></li>
                <li class="breadcrumb-item active" aria-current="page" style="color: var(--tx-lm);">Hakkımızda</li>
            </ol>
        </nav>
        <h1 class="fw-bold mb-1" style="color: var(--tx-l); font-size: 2.2rem;">Kurumsal Kimlik & Vizyon</h1>
        <p class="mb-0" style="color: var(--tx-lm);">Otomotiv sektöründe güvenin, şeffaflığın ve üst düzey hizmetin adresi.</p>
    </div>
</div>

<!-- HİKAYEMİZ VE VİZYON -->
<section class="container-x pb-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <div style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 40px; position: relative;">
                <span style="color: var(--brass); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; display: block; margin-bottom: 12px;">Hikayemiz</span>
                <h3 class="fw-bold mb-4" style="color: var(--tx-l); font-size: 1.8rem; line-height: 1.4;">Lüks ve Güvenilir Araç Alım-Satımında 18 Yıllık Deneyim</h3>
                <p style="color: var(--tx-lm); line-height: 1.7; margin-bottom: 20px;">
                    AutoGallery olarak sektöre adım attığımız günden bu yana, ikinci el otomotiv pazarındaki ezberleri bozmayı hedefledik. Sözlü garantiler yerine, ölçülebilir ve belgelendirilebilir ekspertiz raporlarıyla müşterilerimize tam şeffaflık sunuyoruz.
                </p>
                <p style="color: var(--tx-lm); line-height: 1.7; margin-bottom: 0;">
                    Her biri alanında uzman ekibimizle, premium segmentteki araçları portföyümüze dahil ediyor; hem alıcı hem de satıcı için kusursuz bir deneyim inşa ediyoruz.
                </p>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="row g-4">
                <div class="col-6">
                    <div style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 30px; text-align: center;">
                        <i class="fa-solid fa-award fa-2x mb-3" style="color: var(--brass);"></i>
                        <h2 class="fw-bold text-white mb-1">18+</h2>
                        <span style="color: var(--tx-lm); font-size: 0.9rem;">Yıllık Sektör Tecrübesi</span>
                    </div>
                </div>
                <div class="col-6">
                    <div style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 30px; text-align: center;">
                        <i class="fa-solid fa-car fa-2x mb-3" style="color: var(--brass);"></i>
                        <h2 class="fw-bold text-white mb-1">2.500+</h2>
                        <span style="color: var(--tx-lm); font-size: 0.9rem;">Mutlu Müşteri / Satış</span>
                    </div>
                </div>
                <div class="col-6">
                    <div style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 30px; text-align: center;">
                        <i class="fa-solid fa-shield-halved fa-2x mb-3" style="color: var(--brass);"></i>
                        <h2 class="fw-bold text-white mb-1">%100</h2>
                        <span style="color: var(--tx-lm); font-size: 0.9rem;">Şeffaf Ekspertiz Raporu</span>
                    </div>
                </div>
                <div class="col-6">
                    <div style="background-color: var(--ink2); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 30px; text-align: center;">
                        <i class="fa-solid fa-handshake fa-2x mb-3" style="color: var(--brass);"></i>
                        <h2 class="fw-bold text-white mb-1">7/24</h2>
                        <span style="color: var(--tx-lm); font-size: 0.9rem;">Konsinye ve Destek</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- DEĞERLERİMİZ -->
<section style="background-color: var(--ink2); padding: 90px 0 120px 0; border-top: 1px solid rgba(255,255,255,0.05);">
    <div class="container-x">
        <div class="sec-head text-center mb-5">
            <h2 style="color: var(--tx-l); font-size: 2rem; margin-bottom: 12px;">Değerlerimiz ve İlkelerimiz</h2>
            <p style="color: var(--tx-lm); font-size: 1.05rem;">Bizi sektörde farklı kılan temel iş anlayışımız.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div style="background-color: var(--ink); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 30px; height: 100%;">
                    <div style="color: var(--brass); font-size: 1.5rem; margin-bottom: 16px;"><i class="fa-solid fa-check-to-slot"></i></div>
                    <h4 class="text-white fw-bold mb-2">Mutlak Şeffaflık</h4>
                    <p style="color: var(--tx-lm); font-size: 0.95rem; line-height: 1.6;">Araçlarımızın geçmişini, boya ve tramer detaylarını gizlemeden, tüm çıplaklığıyla rapor halinde sunarız.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div style="background-color: var(--ink); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 30px; height: 100%;">
                    <div style="color: var(--brass); font-size: 1.5rem; margin-bottom: 16px;"><i class="fa-solid fa-gem"></i></div>
                    <h4 class="text-white fw-bold mb-2">Premium Standartlar</h4>
                    <p style="color: var(--tx-lm); font-size: 0.95rem; line-height: 1.6;">Sadece mekanik olarak değil, kozmetik ve kondisyon olarak da en üst düzeydeki araçları portföyümüzde barındırırız.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div style="background-color: var(--ink); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 30px; height: 100%;">
                    <div style="color: var(--brass); font-size: 1.5rem; margin-bottom: 16px;"><i class="fa-solid fa-user-shield"></i></div>
                    <h4 class="text-white fw-bold mb-2">Güvenli Ticaret</h4>
                    <p style="color: var(--tx-lm); font-size: 0.95rem; line-height: 1.6;">Satış öncesi ve sonrasında sunduğumuz danışmanlık hizmetiyle hukuki ve finansal güvenliği garanti ederiz.</p>
                </div>
            </div>
        </div>
    </div>
</section>