@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yönetici Girişi — AutoGallery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background-color: #111; color: #fff; height: 100vh; display: flex; align-items: center; justify-content: center; font-family: system-ui, -apple-system, sans-serif; }
        .login-card { background-color: #1a1a1a; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 40px; width: 100%; max-width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .form-control { background-color: #222; border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 12px 16px; }
        .form-control:focus { background-color: #2a2a2a; border-color: #b6905b; color: #fff; box-shadow: none; }
        .btn-login { background-color: #b6905b; color: #111; font-weight: 700; padding: 12px; border: none; border-radius: 8px; transition: all 0.3s; }
        .btn-login:hover { background-color: #cda46d; }
        .brand { font-weight: 800; font-size: 1.8rem; letter-spacing: 1px; margin-bottom: 30px; text-align: center; }
        .brand span { color: #b6905b; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">AUTO<span>GALLERY</span></div>

        <h5 class="mb-4 text-center text-white-50" style="font-size: 0.95rem;">Yönetim Paneli Girişi</h5>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 text-center mb-3" style="font-size: 0.9rem;"></div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="Username" class="form-label text-white-50 small mb-1"></label>
                <div class="input-group">
                    <span class="input-group-text" style="background-color: #222; border: 1px solid rgba(255,255,255,0.1); border-right: none; color: #b6905b;"><i class="bi bi-person"></i></span>
                    <input asp-for="Username" class="form-control" style="border-left: none;" placeholder="admin" autofocus />
                </div>
                <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label text-white-50 small mb-1"></label>
                <div class="input-group">
                    <span class="input-group-text" style="background-color: #222; border: 1px solid rgba(255,255,255,0.1); border-right: none; color: #b6905b;"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" style="border-left: none;" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-login w-100">Giriş Yap</button>
        </form>

        <div class="mt-4 text-center">
            <a href="/" class="text-white-50 text-decoration-none small"><i class="bi bi-arrow-left me-1"></i> Siteye Dön</a>
        </div>
    </div>
</body>
</html>